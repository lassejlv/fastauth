# Copy to .env; the server and the fastauth binary both read it.

# Postgres, with the tables from migrations/ (the server applies them on start).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acme

# At least 32 bytes. Make one with: openssl rand -hex 32
FASTAUTH_SECRET=

# The origin the browser uses. In development that's Vite, which proxies /api here.
APP_URL=http://localhost:5173
PORT=3000

# Redis or Valkey shared by every instance of the server, so rate limits hold across them.
# Leave it unset when one instance serves the app.
# REDIS_URL=redis://localhost:6379

# Proxies in front of the server that append to x-forwarded-for. Vite's dev proxy is one.
# Directly on the internet, use 0: the socket address is then the client IP.
TRUSTED_PROXIES=1

# The dev mailer appends every email here, one JSON object per line.
MAIL_OUTBOX=outbox.jsonl

# The first admin, created on start if no user has this email.
ADMIN_EMAIL=admin@acme.test
ADMIN_PASSWORD=change me please

# GitHub sign-in, only when both are set. Callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Serve the built React app (web/dist) from this server instead of Vite.
# WEB_DIST=../web/dist
